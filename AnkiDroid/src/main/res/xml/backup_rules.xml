<!--
    The AI API key is encrypted with a device-bound AndroidKeyStore master key which is never
    backed up, so a restored copy of this file could not be decrypted on the target device.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="ai_key_store.xml"/>
</full-backup-content>
