<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialKeyguardLayout="@layout/widget_heatmap"
    android:initialLayout="@layout/widget_heatmap"
    android:configure="com.ichi2.widget.heatmap.HeatmapWidgetConfig"
    android:widgetFeatures="reconfigurable"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="800dp"
    android:maxResizeHeight="400dp"
    android:previewImage="@drawable/widget_heatmap_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:widgetCategory="home_screen"/>
