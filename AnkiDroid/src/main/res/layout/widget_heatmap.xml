<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/heatmap_widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_heatmap_background">

    <TextView
        android:id="@+id/heatmap_widget_deck_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="14sp"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="My Deck"/>

    <ImageView
        android:id="@+id/heatmap_widget_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/heatmap_widget_image_desc"/>

    <TextView
        android:id="@+id/heatmap_widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        tools:text="🔥 12-day streak · 84 reviews/day"/>

    <TextView
        android:id="@+id/empty_widget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone"
        tools:text="Tap to configure"
        tools:visibility="visible"/>
</LinearLayout>
